{
  "permissions": {
    "allow": [
      "Bash(node scripts/office.mjs task *)",
      "Bash(node scripts/office.mjs flow *)",
      "Bash(node scripts/office.mjs meeting *)",
      "Bash(node scripts/office.mjs plan *)",
      "Bash(node scripts/codex-review.mjs *)",
      "PowerShell(node scripts/office.mjs task *)",
      "PowerShell(node scripts/office.mjs flow *)",
      "PowerShell(node scripts/office.mjs meeting *)",
      "PowerShell(node scripts/office.mjs plan *)",
      "PowerShell(node scripts/codex-review.mjs *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/office-event.mjs"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/session-context.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/office-event.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/office-event.mjs"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/chief-guard.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/office-event.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/office-event.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/office-event.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/office-event.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}

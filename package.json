{
  "name": "ai-office",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "office": "node dashboard/server.mjs",
    "office:start": "node scripts/office-bg.mjs start",
    "office:stop": "node scripts/office-bg.mjs stop",
    "office:status": "node scripts/office-bg.mjs status",
    "office:ask": "node scripts/office-ask.mjs",
    "demo": "node dashboard/server.mjs --demo",
    "sync": "node scripts/sync-agents.mjs --write",
    "check": "node scripts/check.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:browser": "node --test test/browser.integration.mjs",
    "verify:aside": "node scripts/aside-fixture-checks.mjs",
    "doctor": "node scripts/doctor.mjs",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "docx": "9.15.2",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "playwright": "1.62.1",
    "pptxgenjs": "4.0.1"
  },
  "overrides": {
    "image-size": "2.0.4",
    "uuid": "11.1.1"
  }
}
